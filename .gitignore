snapshot_report.html

# A consumer's fix branch, checked out as a worktree beside the main checkout
# (README: "Changing the shell from a consumer") so the editable install it
# works on does not disturb whatever main is in the middle of.
.worktrees/

# Claude Code's hooks write here (tool-use traces, notifications). Session
# artifacts of the machine, not of the package.
logs/
